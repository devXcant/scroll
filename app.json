{
  "expo": {
    "name": "SCROLL",
    "slug": "scroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scroll",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.scroll.app",
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "SCROLL needs Screen Time access to block apps when you exceed your limits.",
        "NSUserTrackingUsageDescription": "Not used for ads. Optional analytics only.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scroll.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#06070D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06070D"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.scroll.app",
          "enableGooglePay": true
        }
      ],
      "expo-app-blocker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#06070D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32173387-1823-4ab9-a9fc-ff46927478e8"
      }
    }
  }
}
