EXPO_PUBLIC_FORCE_ONBOARDING=false

EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-...
EXPO_PUBLIC_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Stripe (publishable only — secret goes in server/.env)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_API_URL=http://localhost:3001
# Android emulator: localhost is auto-rewritten to http://10.0.2.2:3001
# Physical phone: use your Mac LAN IP, e.g. http://192.168.1.10:3001
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.scroll.app

# Google OAuth (optional — for onboarding sign-in)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
